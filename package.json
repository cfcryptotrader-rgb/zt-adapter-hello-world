{
  "name": "zt-adapter-hello-world",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Hello World adapter for testing Zero Trust infrastructure integrations.",
  "main": "src/zero-trust-client.js",
  "exports": {
    ".": "./src/zero-trust-client.js",
    "./brokers/docker-local": "./brokers/docker-local/index.js"
  },
  "bin": {
    "zt-audit": "./bin/zt-audit.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "zt:mock": "node src/mock-control-plane.js",
    "demo:deny": "node src/demo-deny.js",
    "demo:allow": "node src/demo-allow.js",
    "demo:record": "bash scripts/record-demo.sh",
    "audit:verify": "node bin/zt-audit.js verify",
    "security:secrets": "node scripts/scan-secrets.js",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "zero-trust",
    "agent",
    "adapter",
    "hello-world"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oscarmackjr-twg/zt-adapter-hello-world.git"
  },
  "bugs": {
    "url": "https://github.com/oscarmackjr-twg/zt-adapter-hello-world/issues"
  },
  "homepage": "https://github.com/oscarmackjr-twg/zt-adapter-hello-world#readme"
}
